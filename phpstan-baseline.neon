			identifier: function.alreadyNarrowedType
			count: 1
			path: includes/Layout.php

		-
			message: '#^Offset ''vehicle_id'' on array\{page\: string, vehicle_id\: string, vehicle_reg_no\: string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
