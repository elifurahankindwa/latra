			path: includes/Layout.php

		-
			message: '#^Offset ''vehicle_reg_no'' on array\{page\: string, vehicle_id\: string, vehicle_reg_no\: string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
