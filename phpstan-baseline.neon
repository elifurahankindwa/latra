parameters:
	ignoreErrors:
		-
			message: '#^Constant APP_ENV not found\.$#'
			identifier: constant.notFound
			count: 1
			path: api.php

		-
			message: '#^Constant LATRA_API_URL not found\.$#'
			identifier: constant.notFound
			count: 5
			path: api.php

		-
			message: '#^Constant LATRA_PASSWORD not found\.$#'
			identifier: constant.notFound
			count: 5
			path: api.php

		-
			message: '#^Constant LATRA_USERNAME not found\.$#'
			identifier: constant.notFound
			count: 5
			path: api.php

		-
			message: '#^While loop condition is always true\.$#'
			identifier: while.alwaysTrue
			count: 1
			path: bin/worker.php

		-
			message: '#^Part \$activities \(non\-empty\-list\<literal\-string&non\-falsy\-string\>\) of encapsed string cannot be cast to string\.$#'
			identifier: encapsedStringPart.nonString
			count: 1
			path: includes/AIAssistant.php

		-
			message: '#^Static method AIAssistant\:\:appName\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: includes/AIAssistant.php

		-
			message: '#^Static method AIAssistant\:\:appVersion\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: includes/AIAssistant.php

		-
			message: '#^Static method AIAssistant\:\:bullet\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: includes/AIAssistant.php

		-
			message: '#^Dead catch \- Throwable is never thrown in the try block\.$#'
			identifier: catch.neverThrown
			count: 1
			path: includes/AITools.php

		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 1
			path: includes/AITools.php

		-
			message: '#^Strict comparison using \!\=\= between mixed and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 2
			path: includes/AITools.php

		-
			message: '#^Offset ''domain'' on array\{lifetime\: int\<0, max\>, path\: non\-falsy\-string, domain\: string, secure\: bool, httponly\: bool, samesite\: ''Lax''\|''lax''\|''None''\|''none''\|''Strict''\|''strict''\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: includes/Auth.php

		-
			message: '#^Comparison operation "\<\=" between int\<400, 407\>\|int\<409, 424\>\|int\<426, 428\>\|int\<430, 499\> and 499 is always true\.$#'
			identifier: smallerOrEqual.alwaysTrue
			count: 1
			path: includes/Automation.php

		-
			message: '#^Constant DB_CHARSET not found\.$#'
			identifier: constant.notFound
			count: 1
			path: includes/Database.php

