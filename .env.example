DB_HOST=127.0.0.1
DB_NAME=latra_wialon
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Relay cutover requires migrations/009_durable_relay.sql and explicit vehicle enrollment.
# Keep legacy only for a coordinated rollback; see RELAY.md before switching a running system.
DELIVERY_ARCHITECTURE=relay

WIALON_BASE_URL=https://hst-api.wialon.com/wialon/ajax.html
WIALON_TOKEN=

LATRA_API_URL=
LATRA_USERNAME=
LATRA_PASSWORD=

# AI Assistant (server-side only — never commit a real key)
# OpenAI-compatible endpoint (OpenAI, OpenRouter, Azure etc.)
OPENAI_API_KEY=
AI_BASE_URL=
OPENAI_MODEL=openai/gpt-4o
AI_RATE_LIMIT=20
AI_MAX_TOKENS=900
AI_TIMEOUT=45
AI_AUDIT=on
