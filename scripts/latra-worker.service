[Unit]
Description=LATRA-Wialon scheduler worker
After=network.target mysql.service

[Service]
Type=simple
WorkingDirectory=/home/codeafrica/latra.codeafrica.co.tz
ExecStart=/opt/cpanel/ea-php84/root/usr/bin/php /home/codeafrica/latra.codeafrica.co.tz/bin/worker.php
Restart=always
RestartSec=3
User=daemon

[Install]
WantedBy=multi-user.target
